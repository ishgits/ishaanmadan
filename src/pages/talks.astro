---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import TalkFeature from '../components/TalkFeature.astro';
import CourseFeature from '../components/CourseFeature.astro';
import ResourceRow from '../components/ResourceRow.astro';
import { getCollection } from 'astro:content';
import { astroOnTap, hasEventPhoto } from '../data/events';
const resources = await getCollection('resources');
const lecture = resources.find(r => r.id === 'organics-lecture');
---
<Layout title="Talks & Teaching | Ishaan Madan" description="Public talks, a free science course, teaching materials, fellowship resources, and moments from sharing science with others." ogImage="/og/talks.png">
  <PageIntro label="Talks & Teaching" title="Sharing the wonder." description="Talks, lessons, and resources for exploring science and finding your own path." />
  <section id="science" aria-label="Talks and learning">
    <TalkFeature />
    <div class="section-block"><CourseFeature /></div>
    {lecture && <ResourceRow resource={lecture} />}
  </section>
  <section class="section-block" id="fellowships" aria-labelledby="fellowship-heading">
    <h2 id="fellowship-heading">Fellowships & finding your path</h2>
    <p class="section-intro">These materials reflect my own experience. Use them as examples while telling your own story, alongside current official guidance.</p>
    {resources.filter(r => r.data.group === 'fellowships').map(resource => <ResourceRow resource={resource} />)}
  </section>
  {hasEventPhoto && <section class="section-block" id="moments" aria-labelledby="moments-heading">
    <h2 id="moments-heading">Moments along the way</h2>
    <p class="section-intro">A few glimpses of sharing ideas and following curiosity.</p>
    <details class="moment">
      <summary><span><strong>Science, a stage, and a room full of curiosity.</strong><br/><span class="moment-date">Astro on Tap · November 17, 2026</span></span><span class="moment-action">View photo <span aria-hidden="true">＋</span></span></summary>
      <figure><img src={astroOnTap.image} alt={astroOnTap.imageAlt} width="2048" height="1536" loading="lazy" decoding="async" /><figcaption>Exploring what makes matter come alive, together. <a class="quiet-link" href="#astro-on-tap">About the talk ↑</a></figcaption></figure>
    </details>
  </section>
  }
  <p class="research-link"><span id="resource-tsc-2026-poster"></span><span id="resource-abscicon-2026"></span><span id="resource-telluride-2025"></span><a class="quiet-link" href="/research/#presentations">Research presentations & posters →</a></p>
  <p class="talk-invitation">Have a group or classroom in mind? <a class="text-link" href="/connect/">Let’s talk →</a></p>
</Layout>
<style>
h2{font-size:clamp(1.7rem,3vw,2.3rem);margin-bottom:20px}.section-intro{color:var(--c-ink-muted);max-width:70ch}
.moment{border-block:1px solid var(--c-line);margin-top:28px}.moment summary{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px 0;list-style:none}.moment summary::-webkit-details-marker{display:none}.moment strong{font-weight:500}.moment-date{color:var(--c-ink-faint);font-size:.8rem}.moment-action{color:var(--c-accent-ink);font-size:.85rem;white-space:nowrap}.moment[open] .moment-action span{display:inline-block;transform:rotate(45deg)}.moment figure{margin:0 0 24px;max-width:900px}.moment img{width:100%;height:auto;border-radius:8px}.moment figcaption{color:var(--c-ink-muted);font-size:.8rem;margin-top:12px}.talk-invitation{margin-top:64px;color:var(--c-ink-muted)}@media(max-width:500px){.moment summary{align-items:start;flex-direction:column;gap:10px}}
</style>
