---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const paperCompanions = [
  {
    title: 'Venus, Sulfuric Acid, and Alternate Chemistries',
    description: 'We test the potential for non-carbon polymers in Venusian atmosphere.',
    href: '/interactive-science/venus-chemistry-story.html',
  },
  {
    title: 'Titan: A Melt Pool and Life\'s Ingredients',
    description:
      'Explore how an impact-created melt pool at Selk crater could make prebiotic chemistry possible on Titan.',
    href: '/interactive-science/titan.html',
  },
];
---

<Layout
  title="Interactive Science | Ishaan Madan"
  description="Interactive, accessible ways to explore scientific research by Ishaan Madan."
>
  <section>
    <p class="eyebrow">Research, made approachable</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Interactive Science</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-muted">
      I am working to turn my scientific papers into interactive, approachable experiences: clearer
      ways to explore the questions, methods, results, and implications behind the research.
    </p>
  </section>

  <section class="mt-12" aria-labelledby="paper-companions-heading">
    <h2 id="paper-companions-heading" class="text-2xl font-semibold tracking-tight md:text-3xl">
      Paper companions
    </h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        paperCompanions.map((paper) => (
          <article class="flex flex-col rounded-2xl border border-line bg-surface/70 p-6 shadow-card md:p-8">
            <h3 class="text-xl font-semibold tracking-tight md:text-2xl">{paper.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-ink-muted">{paper.description}</p>
            <div class="mt-6">
              <Button href={paper.href} variant="primary">Explore the interactive paper</Button>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-ink-faint">More interactive paper companions are in progress.</p>
  </section>
</Layout>
