---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { editorial } from '../../data/editorial';
import { getEntry } from 'astro:content';
import { readingTime } from '../../lib/content';
import retreat from '../../content/articles/first-retreat.html?raw';
import LinkMark from '../../components/LinkMark.astro';
const reflection = (await getEntry('reflections','first-retreat'))!;
---
<Layout title="Meditations & Reflections | Ishaan Madan" description="Join a free weekly meditation circle, listen to guided meditations, and read personal reflections from Ishaan Madan." ogImage="/og/reflections.png">
  <PageIntro label="Meditations & Reflections" title="A little space to pause." description="Meditation and reflection help me understand my experience. Here are a few ways to share in that practice." />
  <section id="gather" class="circle-panel" aria-labelledby="circle-heading">
    <div><h2 id="circle-heading">Weekly meditation circle</h2><p class="circle-time">Sundays · 10–11 AM Eastern</p><p>Practice together online, with space to pause and connect.</p><ul><li>Free, on Google Meet</li><li>All experience levels welcome</li><li>Cameras optional</li></ul><a class="action primary" href={editorial.circleRegistration} target="_blank" rel="noopener">Register for the circle<LinkMark kind="external" /></a><p class="circle-note">Register once to receive the meeting link and calendar invitation.</p></div>
    <img src="/assets/meditation-circle-flyer.webp" alt="Weekly virtual meditation circle flyer: Sundays, 10–11 AM Eastern, on Google Meet. All experience levels welcome; cameras optional." width="1545" height="2000" loading="lazy" />
  </section>
  <section id="practice" class="practice-panel section-block" aria-labelledby="practice-heading"><h2 id="practice-heading">Guided meditations</h2><p>Recorded practices you can follow in your own time. Choose a meditation from my YouTube playlist and settle in at your own pace.</p><a class="text-link" href={editorial.meditationPlaylist} target="_blank" rel="noopener">Listen to meditations<LinkMark kind="external" /></a></section>
  <section id="read" class="section-block" aria-labelledby="reflections-heading"><h2 id="reflections-heading">Personal reflections</h2><article class="reflection-preview"><p class="reflection-meta">{reflection.data.eventDate} · {readingTime(retreat)}</p><h3>{reflection.data.title}</h3><p>{reflection.data.summary}</p><a class="text-link" href={reflection.data.url}>Read reflection</a></article></section>
</Layout>
<style>
.circle-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,300px);gap:48px;align-items:center;border:1px solid var(--c-line);border-radius:12px;background:var(--c-surface);padding:clamp(24px,4vw,44px)}.circle-panel h2{font-size:clamp(1.8rem,3vw,2.6rem);margin-bottom:20px}.circle-panel p,.circle-panel ul{color:var(--c-ink-muted)}.circle-panel .circle-time{color:var(--c-accent-ink);font-size:1.1rem;margin-bottom:20px}.circle-panel ul{padding-left:20px;margin:20px 0 28px;line-height:1.9}.circle-panel .circle-note{font-size:.8rem;margin-top:16px;max-width:42ch}.circle-panel img{width:100%;height:auto;border-radius:6px}.practice-panel{max-width:720px;border-top:1px solid var(--c-line);padding-top:32px}.practice-panel h2,#reflections-heading{font-size:1.8rem}.practice-panel p,.reflection-preview>p{color:var(--c-ink-muted);margin:18px 0 24px;max-width:65ch}.reflection-preview{max-width:720px;border-top:1px solid var(--c-line);margin-top:24px;padding-top:12px}.reflection-preview h3{font-size:1.35rem}.reflection-preview .reflection-meta{font-size:.8rem;margin-bottom:12px}@media(max-width:700px){.circle-panel{grid-template-columns:1fr;gap:28px}.circle-panel img{max-width:270px;justify-self:center}}
</style>
