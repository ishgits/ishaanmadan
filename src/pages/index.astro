---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../consts';
---

<Layout
  title="Ishaan Madan | Planetary Science & Astrobiology"
  description="Computational astrobiologist and PhD student at Purdue modeling chemical pathways for life beyond Earth, building research workflows, and communicating science."
>
  <section
    class="grid gap-8 lg:grid-cols-[minmax(260px,0.8fr)_minmax(0,1.4fr)] lg:items-stretch lg:gap-10"
    aria-labelledby="home-heading"
  >
    <figure class="overflow-hidden rounded-2xl border border-line bg-surface shadow-lift lg:flex lg:min-h-0 lg:flex-col">
      <img
        src="/assets/headshot.jpg"
        alt="Ishaan Madan"
        width="800"
        height="1000"
        class="aspect-[4/5] w-full object-cover lg:h-0 lg:min-h-0 lg:flex-1 lg:aspect-auto"
      />
      <figcaption class="border-t border-line bg-surface p-5 text-sm leading-relaxed text-ink-muted">
        Taken Aug 2025 as part of{' '}
        <a
          href="https://www.purdue.edu/newsroom/purduetoday/2025/Q3/purdue-students-capture-16-competitive-nsf-graduate-research-fellowships-for-2025-17-others-achieve-honorable-mentions/?TSPD_101_R0=08993c5290ab20001b314169cb8f4153bd123d75b9042c973e0b5791030c24ab5ed4c8c3aa4a4a09088cebe30c143000c1fa2c6cb6216d6c4279113ca3410a62073cfd46aefb419c7630d3dea0ea4cfccc25a25e17f4507c2bab049297f6b33c"
          class="link"
          target="_blank"
          rel="noopener"
          >Purdue's NSF Story</a
        >
        <br />
        Photo by John Underwood / Purdue University
      </figcaption>
    </figure>

    <div class="relative overflow-hidden rounded-3xl border border-line bg-surface/70 p-7 shadow-card md:p-12">
      <div
        class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--c-accent) 22%, transparent), transparent 70%)"
        aria-hidden="true"
      >
      </div>
      <p class="eyebrow relative">{SITE.tagline}</p>
      <h1
        id="home-heading"
        class="relative mt-5 text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl"
      >
        I explore life and its potential beyond Earth through scientific investigation and
        contemplative practice.
      </h1>
      <p class="relative mt-6 text-lg leading-relaxed text-ink-muted md:text-xl">
        I'm a PhD student in Planetary Science &amp; Astrobiology at Purdue, where I build automated
        scientific workflows that connect computational chemistry, thermodynamic modeling, prebiotic
        chemistry, planetary environments, and future mission science.
      </p>
      <div class="relative mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href="/work-with-me/" variant="primary">Work With Me</Button>
      </div>
    </div>
  </section>
</Layout>
