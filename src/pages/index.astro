---
import Layout from '../layouts/Layout.astro';
import CourseFeature from '../components/CourseFeature.astro';
import { validateContent } from '../lib/content';
import { editorial } from '../data/editorial';
import LinkMark from '../components/LinkMark.astro';
await validateContent();
const paths = [
 {title:'Research',href:'/research/',description:'The chemistry of life’s beginnings on Earth and its possibilities on other worlds.'},
 {title:'Meditations & Reflections',href:'/reflections/',description:'Weekly meditation circles, guided practices, and personal reflections.'},
 {title:'Courses & Resources',href:'/resources/',description:'Science lessons, presentations, and fellowship materials to support your own path.'},
];
---
<Layout title="Ishaan Madan | Exploring worlds. Discovering myself." description="Ishaan Madan, planetary science PhD student at Purdue, exploring research, teaching, meditation, and self-understanding.">
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="hero-copy">
      <p class="eyebrow">Ishaan Madan / Scientist & curious human</p>
      <h1 id="home-heading">Exploring other worlds.<br/><span>Discovering myself.</span></h1>
      <p class="lede">I’m Ishaan, a PhD student in Planetary Science and Astrobiology at Purdue. I explore life’s beginnings through research, share science through teaching, and practice meditation as a way to understand myself.</p>
      <a class="quiet-link" href="/about/">Read my story</a>
      <p class="hero-affiliation">Purdue University <span aria-hidden="true">·</span> NSF Graduate Research Fellow</p>
    </div>
    <figure class="hero-portrait">
      <img src="/assets/headshot-800.webp" srcset="/assets/headshot-480.webp 480w, /assets/headshot-800.webp 800w" sizes="(max-width: 700px) 280px, (max-width: 1000px) 35vw, 400px" width="800" height="1000" alt="Ishaan Madan standing in front of a chemistry whiteboard." fetchpriority="high" />
      <figcaption>At Purdue, August 2025<br/><a href={editorial.purduePortraitStory} target="_blank" rel="noopener">John Underwood / Purdue University<LinkMark kind="external" /></a></figcaption>
    </figure>
  </section>

<section class="home-paths section-block" aria-label="Research, meditation, and learning">
 {paths.map(path=><a class="path-card" href={path.href}><h2>{path.title}</h2><p>{path.description}</p><span aria-hidden="true">→</span></a>)}
</section>
<div class="section-block"><CourseFeature /></div>
<section class="home-conversation section-block"><h2>Let’s have a conversation.</h2><p>A question, a shared curiosity, or something you’re working through.</p><a class="text-link" href="/connect/">Book a conversation</a></section>
</Layout>
<style>
.home-hero { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(260px,.85fr); align-items:center; gap:clamp(36px,6vw,90px); padding:20px 0 30px; }
.hero-copy h1 { font-size:clamp(2.7rem,5.25vw,4.6rem); line-height:1.07; margin:26px 0; letter-spacing:-.055em; }
.hero-copy h1 span { color:var(--c-accent-ink); }
.hero-copy .lede { font-size:1.02rem; max-width:54ch; }
.hero-affiliation { margin-top:28px; font-size:.72rem; color:var(--c-ink-faint); }
.hero-affiliation span { margin:0 8px; }
.hero-portrait { margin:0; }
.hero-portrait img { display:block; width:100%; aspect-ratio:4/5; object-fit:cover; border:1px solid var(--c-line-strong); border-radius:160px 160px 10px 10px; }
.hero-portrait figcaption { margin-top:18px; color:var(--c-ink-faint); font-size:.65rem; line-height:1.6; }

.home-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.path-card{display:flex;flex-direction:column;padding:28px;border:1px solid var(--c-line);border-radius:10px;background:var(--c-surface)}.path-card:hover{border-color:var(--c-accent-ink)}.path-card h2{font-size:1.35rem;line-height:1.3;margin-bottom:16px}.path-card p{font-size:.92rem;color:var(--c-ink-muted)}.path-card span{color:var(--c-accent-ink);margin-top:auto;padding-top:24px}.home-conversation{max-width:650px;padding-top:32px;border-top:1px solid var(--c-line)}.home-conversation h2{font-size:1.8rem}.home-conversation p{color:var(--c-ink-muted);margin:16px 0}
@media(max-width:700px){.home-hero{grid-template-columns:1fr;gap:32px}.hero-copy h1{font-size:clamp(2.5rem,10vw,3.5rem)}.hero-portrait{width:240px;justify-self:center}.hero-portrait img{aspect-ratio:1;object-position:center 30%}.home-paths{grid-template-columns:1fr}.path-card{padding:24px}.hero-portrait figcaption{text-align:center}}
</style>
