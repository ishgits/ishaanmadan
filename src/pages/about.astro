---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ChapterNav from '../components/ChapterNav.astro';
import RelatedContent from '../components/RelatedContent.astro';
import { eras } from '../data/story';
import { readingTime } from '../lib/content';
const chapters = [{id:'childhood',label:'Childhood'},{id:'immigration',label:'Immigration'},{id:'college',label:'College'},{id:'epic',label:'Epic'},{id:'research',label:'Research'},{id:'beyond',label:'Beyond research'},{id:'learning',label:'What I’m learning'}];
const connections: Record<string, {href:string;label:string}[]> = {
 immigration:[{href:'/resources/#fellowships',label:'Resources for finding your own path'}],
 research:[{href:'/research/venus/',label:'The Venus project in Sweden'},{href:'/research/titan/',label:'My Titan research at Purdue'}],
 beyond:[{href:'/reflections/first-retreat/',label:'What I learned on retreat'}],
};
---
<Layout title="A path of self-discovery | Ishaan Madan" description="From New Delhi to planetary science: Ishaan Madan's story of immigration, curiosity, work, reflection, and self-discovery." ogImage="/og/about.png">
  <PageIntro label={`My Story / ${readingTime(eras.flatMap(e=>e.paras).join(' '))}`} title="A path of self-discovery" description="Science, work, meditation, and the transitions between them have each helped me learn more about who I am and what matters to me.">
    <p class="central-pull">At the center of it all has been one recurring pull: the process of self-discovery.</p>
  </PageIntro>
  <aside class="short-version"><p class="eyebrow">The short version</p><p>Today, I’m a PhD student in Planetary Science and Astrobiology at Purdue. I grew up in New Delhi, immigrated to the United States at thirteen, and went to college planning to become a surgeon. Astronomy and chemistry led me toward astrobiology; after working at Epic, I chose to return to research. Alongside science, meditation and reflection keep teaching me about myself.</p></aside>
  <ChapterNav chapters={chapters}/>
  <article class="story-timeline" aria-label="My story in chapters">
    {eras.map((era,i)=><section id={chapters[i].id} class="story-era"><div class="era-marker"><p class="eyebrow">{era.marker}</p><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span></div><div class="era-copy"><h2>{era.title}</h2>{era.paras.map(p=><p set:html={p}/>)}{connections[chapters[i].id] && <div class="text-actions">{connections[chapters[i].id].map(link=><a class="text-link" href={link.href}>{link.label}</a>)}</div>}</div></section>)}
    <p class="story-signature">With love and gratitude,<br/><span>Ishaan</span></p>
  </article>
  <RelatedContent links={[{href:'/research/',title:'Follow the scientific questions',description:'Chemical possibility on Titan and Venus.'},{href:'/reflections/',title:'The practice of paying attention',description:'Reflections, guided meditations, and community.'},{href:'/connect/',title:'Share a little of your story',description:'A question or a conversation can be a place to begin.'}]}/>
</Layout>
<style>
.central-pull { font-family:Georgia,serif;font-size:1.45rem;line-height:1.5;color:var(--c-accent-ink);margin-top:26px;max-width:54ch; }
.short-version { display:grid;grid-template-columns:180px 1fr;gap:30px;border-top:1px solid var(--c-line);padding:30px 0; }.short-version>p:last-child { color:var(--c-ink-muted);max-width:76ch;font-size:.95rem; }
.story-timeline { margin:60px auto 0;max-width:1020px; }.story-era { display:grid;grid-template-columns:170px minmax(0,1fr);gap:45px;margin-bottom:64px;scroll-margin-top:115px; }.era-marker { border-top:1px solid var(--c-line);padding-top:18px; }.era-marker span { display:block;font:400 3rem Georgia,serif;color:var(--c-ink-faint);margin-top:12px; }.era-copy { max-width:70ch; }.era-copy h2 { font-size:2rem;margin-bottom:24px; }.era-copy p { color:var(--c-ink-muted);margin-top:18px;line-height:1.85; }.story-signature { text-align:center;color:var(--c-ink-muted);padding:20px; }.story-signature span { font-family:Georgia,serif;font-size:2.3rem;font-style:italic;color:var(--c-accent-ink); }
@media(max-width:700px){.short-version{grid-template-columns:1fr;gap:14px;}.story-era{grid-template-columns:1fr;gap:18px;margin-bottom:46px;}.era-marker{display:flex;justify-content:space-between;align-items:center;}.era-marker span{font-size:1.3rem;margin:0;}.era-copy h2{font-size:1.7rem;}.story-timeline{margin-top:35px;}}
</style>
