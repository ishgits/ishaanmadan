---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../consts';
---
<Layout title="Connect | Ishaan Madan" description="Connect with Ishaan Madan for research collaboration, mentorship, science communication, teaching, and community." ogImage="/og/connect.png">
  <PageIntro label="Connect" title="Good questions can start a conversation." description="I enjoy connecting with people who are exploring, building, or finding their next step. If something here resonates with you, I’d be glad to hear about it." />
  <div class="invitations">
    <section><p class="eyebrow">01 / Research & collaboration</p><h2>Explore an idea together.</h2><p>A scientific question, a computational workflow, or a focused project that benefits from chemistry, systems thinking, and clear communication.</p><p class="note-prompt">Tell me what you’re investigating, where you feel stuck, and what a useful next step might look like.</p></section>
    <section><p class="eyebrow">02 / Mentorship</p><h2>Find a little more direction.</h2><p>Thinking through a research path, a fellowship application, or the transition into something new? I’m happy to share what I’ve learned.</p><p class="note-prompt">Tell me where you are in your journey and the question you’re trying to work through.</p></section>
    <section><p class="eyebrow">03 / Teaching & community</p><h2>Make an idea easier to understand.</h2><p>A science conversation, teaching opportunity, or community project that helps curious people engage with complex questions.</p><p class="note-prompt">Tell me who it’s for, what you hope they’ll take away, and any timing you have in mind.</p></section>
  </div>
  <section class="conversation" aria-labelledby="conversation-heading"><div><p class="eyebrow">A place to begin</p><h2 id="conversation-heading">Send a short note.</h2><p>I try to keep much of this freely available, especially for students and early-career researchers. My time is shared across PhD projects, collaborations, communication, and mentoring, so a little context helps me understand how I can be useful.</p><div class="actions"><a class="action primary" href={`mailto:${SITE.email}`}>Email me ↗</a><a class="action" href={SITE.calendar} target="_blank" rel="noopener">Book a conversation ↗</a></div><p class="email-address">{SITE.email}</p></div><aside><p class="eyebrow">For a little more context</p><a href={SITE.academicCV} target="_blank" rel="noopener"><h3>Academic CV ↗</h3><p>Publications, research, teaching, and conferences.</p></a><a href={SITE.industryCV} target="_blank" rel="noopener"><h3>Industry CV ↗</h3><p>A concise overview of professional experience.</p></a></aside></section>
</Layout>
<style>.invitations{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;}.invitations section{border-top:1px solid var(--c-line);padding-top:24px;}.invitations h2{font-size:1.65rem;margin:20px 0;}.invitations p:not(.eyebrow){font-size:.92rem;color:var(--c-ink-muted);}.invitations p.note-prompt{font-size:.82rem;border-left:1px solid var(--c-line-strong);padding-left:16px;margin-top:24px;}.conversation{display:grid;grid-template-columns:1.5fr 1fr;gap:70px;margin-top:80px;padding:40px;border:1px solid var(--c-line);border-radius:10px;background:var(--c-surface);}.conversation h2{font-size:2.5rem;margin:18px 0;}.conversation p:not(.eyebrow){color:var(--c-ink-muted);font-size:.92rem;}.conversation .email-address{font-size:.75rem!important;margin-top:14px;}.conversation aside{padding-left:35px;border-left:1px solid var(--c-line);}.conversation aside>a{display:block;margin-top:26px;}.conversation h3{font-size:1.2rem;margin-bottom:10px;}@media(max-width:800px){.invitations,.conversation{grid-template-columns:1fr;gap:36px;}.conversation{padding:26px;}.conversation aside{padding:26px 0 0;border-left:0;border-top:1px solid var(--c-line);}}</style>
