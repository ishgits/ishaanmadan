---
import Layout from '../layouts/Layout.astro';
import LinkMark from '../components/LinkMark.astro';
import { SITE } from '../consts';
---
<Layout title="Book a Conversation | Ishaan Madan" description="Book a 30-minute conversation with Ishaan Madan about research, mentorship, teaching, or a shared curiosity." ogImage="/og/connect.png">
<section class="booking" aria-labelledby="booking-heading">
<h1 id="booking-heading">Let’s talk.</h1>
<p class="lede">If something here resonates with you, I’d be glad to hear from you.</p>
<a class="action primary" href={SITE.calendar} target="_blank" rel="noopener">Book a 30-minute conversation<LinkMark kind="external" /></a>
<p class="booking-meta">30 minutes · Google Meet</p>
<p>Prefer a note? <a class="quiet-link" href={`mailto:${SITE.email}`}>Email me</a>.</p>
<p class="booking-context">We can talk about research, mentorship, teaching, or a question you’re curious about. Bring a little context about what’s on your mind.</p>
</section>
</Layout>
<style>.booking{max-width:680px;padding:24px 0 48px}.booking h1{font-size:clamp(2.5rem,5vw,4rem);margin-bottom:24px}.booking .action{margin-top:30px}.booking p{color:var(--c-ink-muted)}.booking .booking-meta{font-size:.85rem;margin:14px 0 24px}.booking-context{border-top:1px solid var(--c-line);padding-top:28px;margin-top:36px}</style>
