---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Meditations | Ishaan Madan"
  description="Guided meditations, reflections, and future meditation circles from Ishaan Madan."
>
  <section>
    <p class="eyebrow">Meditation &amp; reflection</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Meditations</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-muted">
      A growing space for guided practice, reflections, and community around meditation.
    </p>
  </section>

  <section class="mt-12 grid gap-4 md:grid-cols-2" aria-label="Meditation resources">
    <article class="rounded-2xl border border-line bg-surface/70 p-6 shadow-card md:p-8">
      <h2 class="text-2xl font-semibold tracking-tight">Guided Meditations by Ishaan Madan</h2>
      <p class="mt-3 leading-relaxed text-ink-muted">
        Some meditations I've recorded in the past, many more to come!
      </p>
      <div class="mt-6">
        <Button
          href="https://www.youtube.com/playlist?list=PLYDo0sMCDVOkjPQ5zTfEHOHTlasQcRzH8"
          variant="primary"
          external
        >
          Listen on YouTube
        </Button>
      </div>
    </article>

    <article class="rounded-2xl border border-line bg-surface/70 p-6 shadow-card md:p-8">
      <h2 class="text-2xl font-semibold tracking-tight">My First Virtual Meditation Retreat</h2>
      <p class="mt-3 leading-relaxed text-ink-muted">
        I recently attended a meditation retreat where I meditated for 50+ hours over a span of a
        few days. You can read about my experience here.
      </p>
      <div class="mt-6">
        <Button href="/meditations/first-retreat-reflections.html" variant="primary">
          Read my reflections
        </Button>
      </div>
    </article>

    <article class="rounded-2xl border border-line bg-surface/70 p-6 shadow-card md:col-span-2 md:p-8">
      <h2 class="text-2xl font-semibold tracking-tight">Live Meditation Circles</h2>
      <p class="mt-3 leading-relaxed text-ink-muted">
        A place to virtually connect and engage in meditative practice with like-minded folks.
        Always free. More information coming soon.
      </p>
    </article>
  </section>
</Layout>
