---
interface Props {
  tone?: 'default' | 'accent' | 'success';
  class?: string;
}
const { tone = 'default', class: className } = Astro.props;

const tones = {
  default: 'border-line bg-inset text-ink-muted',
  accent: 'border-accent/40 bg-accent/10 text-accent-ink',
  success: 'border-emerald-400/40 bg-emerald-400/10 text-emerald-600 dark-tone',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-3 py-1 font-mono text-xs tracking-wide',
    tones[tone],
    className,
  ]}><slot /></span
>

<style>
  /* emerald text needs to brighten on the dark canvas for AA contrast */
  :global(html[data-theme='dark']) .dark-tone {
    color: #6ee7b7;
  }
</style>
