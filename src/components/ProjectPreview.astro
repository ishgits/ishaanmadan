---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
---
<article class:list={['project-preview', p.imageMode]}>
  <div class="project-visual">
    <img src={p.image} alt={p.imageAlt} width={p.imageWidth} height={p.imageHeight} loading="lazy" decoding="async" />
    <span class="visual-label">{p.name}</span>
  </div>
  <div class="project-copy">
    <p class="eyebrow">{p.setting}</p>
    <h3>{p.question}</h3>
    <p>{p.summary}</p>
    <div class="text-actions">
      <a class="text-link" href={`/research/${project.id}/`}>Explore the {p.name} project</a>
    </div>
    <p class="asset-credit">{p.imageCredit}</p>
  </div>
</article>
