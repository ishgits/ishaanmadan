---
import { SITE, NAV } from '../consts';
import LinkMark from './LinkMark.astro';
---
<footer class="site-footer" id="site-footer">
  <div class="footer-grid">
    <div class="footer-identity"><a href="/" class="site-name">Ishaan Madan</a><p>Planetary scientist. Curious human.</p><p class="footer-note">PhD student at Purdue University<br/>NSF Graduate Research Fellow</p><a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
    <nav aria-label="Footer navigation"><p class="eyebrow">Explore</p>{NAV.map(n => <a href={n.href}>{n.label}</a>)}</nav>
    <div><p class="eyebrow">Connect & follow</p><a href={SITE.calendar} target="_blank" rel="noopener">Book a conversation<LinkMark kind="external" /></a><a href={SITE.academicCV} target="_blank" rel="noopener">Academic CV<LinkMark kind="external" /></a><a href={SITE.industryCV} target="_blank" rel="noopener">Industry CV<LinkMark kind="external" /></a><div class="footer-socials"><a href={SITE.orcid}>ORCID</a><a href={SITE.linkedin}>LinkedIn</a><a href={SITE.github}>GitHub</a></div><div class="footer-socials"><a href={SITE.youtube.scientish}>Scient_ish</a><a href={SITE.youtube.spiritualish}>Spiritual_ish</a><a href={SITE.youtube.notesbyish}>Notes by Ish</a></div></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Ishaan Madan</span><span>Curiosity, connection, and a little more understanding.</span></div>
</footer>
