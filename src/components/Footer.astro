---
import { SITE, FOOTER_NAV } from '../consts';
import LittlePause from './LittlePause.astro';
---
<footer class="site-footer" id="site-footer">
  <div class="footer-grid">
    <div class="footer-identity"><a href="/" class="site-name">Ishaan Madan</a><p>Scientist & curious human.</p><a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
    <nav aria-label="Footer navigation"><p class="eyebrow">Explore</p>{FOOTER_NAV.map(n => <a href={n.href}>{n.label}</a>)}</nav>
    <div><p class="eyebrow">Connect & follow</p><div class="footer-socials"><a href={SITE.linkedin}>LinkedIn</a><a href={SITE.github}>GitHub</a></div><a class="quiet-link" href="/connect/#follow">More ways to connect →</a></div>
    <LittlePause />
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Ishaan Madan</span><span>Curiosity, connection, and a little more understanding.</span></div>
</footer>
