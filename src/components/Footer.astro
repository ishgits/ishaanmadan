---
import { SITE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line bg-surface/60">
  <div class="mx-auto grid max-w-(--container-site) gap-10 px-6 py-12 sm:grid-cols-2 md:px-10">
    <div>
      <p class="font-display text-lg font-semibold">Ishaan Madan</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        PhD student in Planetary Science &amp; Astrobiology at Purdue University · NSF Graduate
        Research Fellow
      </p>
      <p class="mt-4 text-sm">
        <a href={`mailto:${SITE.email}`} class="link">{SITE.email}</a>
      </p>
      <p class="mt-2 text-sm">
        <a href={SITE.calendar} class="link" target="_blank" rel="noopener">Book a time to meet with me</a>
      </p>
    </div>

    <div class="sm:justify-self-end">
      <h2 class="eyebrow">Elsewhere</h2>
      <SocialLinks variant="inline" class="mt-4 text-sm" />
    </div>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-(--container-site) px-6 py-5 text-xs text-ink-faint md:px-10">
      © {year} Ishaan Madan · Built with Astro · Studying chemical possibility on worlds beyond
      Earth
    </p>
  </div>
</footer>
