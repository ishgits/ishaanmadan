---
import { SITE } from '../consts';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul class:list={['space-y-4', className]}>
  <li class="flex items-center gap-3">
    <svg class="h-5 w-5 shrink-0 text-[#A6CE39]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zM7.675 5.816c.695 0 1.259.564 1.259 1.259s-.564 1.259-1.259 1.259-1.259-.564-1.259-1.259.564-1.259 1.259-1.259zm1.054 12.207H6.622V9.742h2.107v8.281zm3.585 0h-2.107V5.947h5.692c4.462 0 6.416 3.194 6.416 6.038 0 3.1-2.422 6.038-6.391 6.038h-3.61zm0-10.171v8.264h3.352c3.934 0 4.496-2.984 4.496-4.131 0-1.867-1.194-4.133-4.572-4.133h-3.276z"
      ></path>
    </svg>
    <a href={SITE.orcid} class="link" target="_blank" rel="noopener">ORCID</a>
  </li>

  <li class="flex items-center gap-3">
    <svg class="h-5 w-5 shrink-0 text-[#4d9fd6]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M20.451 20.451h-3.554V14.89c0-1.327-.025-3.036-1.849-3.036-1.85 0-2.134 1.445-2.134 2.939v5.658H9.36V9h3.414v1.561h.047c.476-.9 1.637-1.849 3.37-1.849 3.604 0 4.27 2.372 4.27 5.455v6.284zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.114 20.451H3.56V9h3.554v11.451z"
      ></path>
    </svg>
    <a href={SITE.linkedin} class="link" target="_blank" rel="noopener">LinkedIn</a>
  </li>

  <li class="flex items-center gap-3">
    <svg class="h-5 w-5 shrink-0 text-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56 0-.28-.01-1.2-.02-2.17-3.2.7-3.88-1.54-3.88-1.54-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.78 2.7 1.27 3.36.98.1-.75.4-1.27.72-1.56-2.56-.3-5.26-1.28-5.26-5.7 0-1.26.45-2.28 1.2-3.08-.12-.3-.52-1.5.12-3.12 0 0 .98-.32 3.2 1.18a11.08 11.08 0 0 1 5.82 0c2.22-1.5 3.2-1.18 3.2-1.18.64 1.62.24 2.82.12 3.12.75.8 1.2 1.82 1.2 3.08 0 4.43-2.7 5.4-5.28 5.7.42.36.78 1.07.78 2.16 0 1.56-.02 2.82-.02 3.2 0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
      ></path>
    </svg>
    <a href={SITE.github} class="link" target="_blank" rel="noopener">GitHub</a>
  </li>

  <li class="flex items-start gap-3">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#e5484d]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M23.498 6.186a2.974 2.974 0 0 0-2.09-2.103C19.197 3.5 12 3.5 12 3.5s-7.197 0-9.408.583A2.974 2.974 0 0 0 .502 6.186 31.37 31.37 0 0 0 0 12a31.37 31.37 0 0 0 .502 5.814 2.974 2.974 0 0 0 2.09 2.103C4.803 20.5 12 20.5 12 20.5s7.197 0 9.408-.583a2.974 2.974 0 0 0 2.09-2.103A31.37 31.37 0 0 0 24 12a31.37 31.37 0 0 0-.502-5.814zM9.75 15.02V8.98l6.5 3.02-6.5 3.02z"
      ></path>
    </svg>
    <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <a href={SITE.youtube.scientish} class="link" target="_blank" rel="noopener">Scient_ish</a>
      <span class="text-ink-faint" aria-hidden="true">·</span>
      <a href={SITE.youtube.spiritualish} class="link" target="_blank" rel="noopener">Spiritual_ish</a>
      <span class="text-ink-faint" aria-hidden="true">·</span>
      <a href={SITE.youtube.notesbyish} class="link" target="_blank" rel="noopener">Notes by Ish</a>
    </span>
  </li>
</ul>
