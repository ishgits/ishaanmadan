---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  level?: 1 | 2;
  class?: string;
}
const { eyebrow, title, id, level = 2, class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2';
---

<div class:list={['max-w-2xl', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag
    id={id}
    class:list={[
      'mt-3 font-semibold tracking-tight',
      level === 1 ? 'text-4xl leading-tight md:text-5xl' : 'text-2xl md:text-3xl',
    ]}
  >
    {title}
  </Tag>
  <slot />
</div>
