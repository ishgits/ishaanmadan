---
import { astroOnTap as talk, hasEventPhoto } from '../data/events';
import LinkMark from './LinkMark.astro';
interface Props { home?: boolean; }
const { home = false } = Astro.props;
---
<article class:list={["talk-feature", { "text-only": !hasEventPhoto }]} id="astro-on-tap" aria-labelledby="talk-heading">
  {hasEventPhoto && <figure>
    <img src={talk.image} width="2048" height="1536" alt={talk.imageAlt} loading="lazy" decoding="async" />
    <figcaption>{talk.context} · <time datetime={talk.isoDate}>{talk.date}</time></figcaption>
  </figure>}
  <div class="talk-copy">
    <p class="eyebrow">{home ? 'A recent moment / Public talk' : 'Public talk'}</p>
    <h2 id="talk-heading">{talk.title}</h2>
    <p>{talk.summary}</p>
    <div class="text-actions">
      <a class="text-link" href={talk.slides} target="_blank" rel="noopener">View slides<LinkMark kind="external" /></a>
      {home && <a class="quiet-link" href="/talks/">More talks & teaching →</a>}
    </div>
  </div>
</article>
<style>
.talk-feature{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);align-items:center;gap:clamp(28px,5vw,64px)}
.talk-feature.text-only{grid-template-columns:1fr}
figure{margin:0;min-width:0}img{display:block;width:100%;height:auto;border-radius:10px}figcaption{margin-top:12px;font-size:.75rem;color:var(--c-ink-faint)}
h2{font-size:clamp(1.9rem,3.5vw,3rem);margin:18px 0 24px}.talk-copy>p:not(.eyebrow){color:var(--c-ink-muted);max-width:48ch}
@media(max-width:760px){.talk-feature{grid-template-columns:1fr;gap:24px}h2{margin:14px 0 18px}}
</style>
