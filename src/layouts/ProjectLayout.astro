---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Layout from './Layout.astro';
import PublicationList from '../components/PublicationList.astro';
import ResourceRow from '../components/ResourceRow.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ChapterNav from '../components/ChapterNav.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const publications = (await Promise.all(p.publications.map(ref => getEntry(ref)))).filter(Boolean) as CollectionEntry<'publications'>[];
const resources = (await Promise.all(p.resources.map(ref => getEntry(ref)))).filter(Boolean) as CollectionEntry<'resources'>[];
const other = project.id === 'titan' ? 'venus' : 'titan';
const schema = { '@type':'CollectionPage', name:p.question, description:p.summary, author:{'@id':new URL('/#ishaan',Astro.site).href}, hasPart:publications.map(({data:d})=>({'@type':'ScholarlyArticle', name:d.title, author:d.authors.map(name=>({'@type':'Person',name})), datePublished:String(d.year), url:`https://doi.org/${d.doi}`, isPartOf:{'@type':'Periodical',name:d.venue}})) };
---
<Layout title={`${p.name}: ${p.question} | Ishaan Madan`} description={p.summary} ogImage={`/og/${project.id}.png`} schema={schema}>
  <a class="quiet-link" href="/research/">← Research</a>
  <header class="project-header"><div><p class="eyebrow">{p.name} / Project overview</p><h1>{p.question}</h1><p class="lede">{p.summary}</p><div class="actions"><a class="action primary" href={`/research/${project.id}/explore/`}>Explore the interactive ↗</a><a class="action" href="#papers">Read the papers ↓</a></div></div><figure class:list={['project-image',p.imageMode]}><img src={p.image} alt={p.imageAlt} width="800" height={p.imageMode === 'planet' ? 800 : 400}/><figcaption>{p.imageCredit}</figcaption></figure></header>
  <ChapterNav chapters={[{id:'brief',label:'In brief'},{id:'contribution',label:'My contribution'},{id:'approach',label:'The approach'},{id:'papers',label:'Papers & resources'}]}/>
  <div class="project-body">
    <section id="brief"><p class="eyebrow">In brief</p><h2>What the work suggests</h2><p>{p.finding}</p><div class="limits"><h3>Where the evidence stops</h3><p>{p.limitations}</p></div></section>
    <section id="contribution"><p class="eyebrow">The people behind the work</p><h2>My contribution</h2><p>{p.contribution}</p></section>
    <section id="approach"><p class="eyebrow">The approach</p><h2>Turning a question into calculations</h2><p>{p.approach}</p><div class="inside-note"><h3>{p.insideTitle}</h3><p>{p.inside}</p></div></section>
    <section class="explore-note"><p class="eyebrow">See the ideas take shape</p><h2>Step inside the science.</h2><p>Follow the setting, explore the model, and take a closer look at the evidence. Technical explanations are there when you want them.</p><a class="action primary" href={`/research/${project.id}/explore/`}>Explore {p.name} ↗</a></section>
    <section><p class="eyebrow">An open question</p><h2>{p.nextQuestion}</h2></section>
  </div>
  <section class="section-block" id="papers"><div class="section-heading"><div><p class="eyebrow">Go to the source</p><h2>Papers & related resources</h2></div></div><PublicationList publications={publications}/>{p.dataUrl && <p class="data-link"><a class="text-link" href={p.dataUrl}>{p.dataLabel} ↗</a></p>}{resources.map(resource=><ResourceRow resource={resource}/>)}</section>
  <section class="project-connection"><p class="eyebrow">A personal connection</p><p>{p.connection}</p><a class="text-link" href={`/about/#${p.storyAnchor}`}>Read that part of my story →</a></section>
  <RelatedContent links={[{href:`/research/${other}/`,title:`Another world: ${other === 'titan' ? 'Titan' : 'Venus'}`,description:'Explore a different setting for chemical possibility.'},{href:'/connect/',title:'Continue the conversation',description:'Questions, research ideas, and opportunities to learn together.'}]}/>
</Layout>
<style>
.project-header { display:grid;grid-template-columns:1.4fr 1fr;gap:64px;align-items:center;padding:46px 0 50px; }.project-header h1 { font-size:clamp(2.4rem,4.4vw,3.8rem);margin:22px 0; }.project-image { min-width:0; }.project-image img { width:100%;height:auto; }.project-image.planet img { border-radius:50%; }.project-image.molecule img { background:#f5f1e8;border-radius:8px;padding:22px; }.project-image figcaption { color:var(--c-ink-faint);font-size:.65rem;margin-top:18px; }
.project-body { max-width:72ch;margin:60px auto 0; }.project-body>section { margin-bottom:62px; }.project-body h2 { font-size:clamp(1.8rem,3vw,2.5rem);margin:14px 0 22px; }.project-body p:not(.eyebrow) { color:var(--c-ink-muted); }.limits,.inside-note { border-left:2px solid var(--c-accent);padding:20px 26px;margin-top:30px;background:var(--c-surface); }.project-body h3 { font-size:1.15rem;margin-bottom:12px; }.project-body .limits p,.project-body .inside-note p { font-size:.92rem; }.explore-note { padding:34px;border:1px solid var(--c-line-strong);border-radius:8px; }.explore-note .action { margin-top:25px; }.data-link { margin:28px 0; }.project-connection { max-width:72ch;margin:70px auto 0;border-top:1px solid var(--c-line);padding-top:30px; }.project-connection>p:not(.eyebrow) { color:var(--c-ink-muted);margin:18px 0; }
@media(max-width:700px){.project-header{grid-template-columns:1fr;gap:34px;padding-top:30px;}.project-image{max-width:300px;justify-self:center;}.project-body{margin-top:40px;}.explore-note{padding:24px;}}
</style>
